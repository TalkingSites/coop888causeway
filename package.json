{
  "name": "coop888causeway",
  "private": true,
  "description": "A SpaceClub site. Its content lives in src/ and its settings in spaceclub.json; everything else comes from the spaceclub package.",
  "scripts": {
    "build": "npx @11ty/eleventy && (npx pagefind --site _site --verbose || echo \"Search index failed\")",
    "start": "npx @11ty/eleventy --serve",
    "serve": "node node_modules/spaceclub/server/index.cjs",
    "list": "node scripts/list-content.js --pretty"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "spaceclub": "https://codeload.github.com/TalkingSites/spaceclub/tar.gz/refs/tags/v2.1.0",
    "pagefind": "1.5.2"
  },
  "version": "1.0.0"
}
