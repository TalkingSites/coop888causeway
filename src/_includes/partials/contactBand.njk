<section class="band">
<div class="container split split-contact">
<div>
<h2>Email</h2>
<p><a class="big-link" href="mailto:{{ contactEmail }}">{{ contactEmail }}</a></p>
<h2 class="mt-5">Find us</h2>
<address class="contact-address text-preline">{{ contactAddress }}</address>
<a class="link-arrow" href="{{ contactMap }}" rel="noopener">Open in Maps <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
</div>
<figure class="photo-rounded"><img src="{{ sectionImage }}" alt="{{ sectionAlt }}" loading="lazy"/></figure>
</div>
</section>
